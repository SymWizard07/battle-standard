{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../protocol/**/*.ts", "../shared/**/*.ts", "../../src/lib/types.ts"],
  "exclude": ["../protocol/protocol.test.ts", "../protocol/session.test.ts", "**/*.test.ts"],
}
